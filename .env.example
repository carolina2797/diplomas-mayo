# Copy this file to .env.local and fill in the real values.
# Never commit .env.local — it's already in .gitignore.

# Service account email from Google Cloud (IAM & Admin > Service Accounts).
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private key. Keep the surrounding quotes and \n sequences
# exactly as they appear in the downloaded JSON key's "private_key" field.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The spreadsheet ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
